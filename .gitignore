node_modules/
frontend/node_modules/
backend/node_modules/

# ======================
# BUILD FILES
# ======================
dist/
build/
frontend/dist/
backend/dist/

# ======================
# ENV FILES (VERY IMPORTANT)
# ======================
.env
.env.*
frontend/.env
backend/.env

# ======================
# LOG FILES
# ======================
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ======================
# OS FILES
# ======================
.DS_Store
Thumbs.db

# ======================
# EDITOR FILES
# ======================
.vscode/*
!.vscode/extensions.json
.idea/

# ======================
# CACHE / TEMP
# ======================
.cache/
.parcel-cache/
frontend/.vite/
tmp/
temp/

# ======================
# COVERAGE
# ======================
coverage/

# ======================
